generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(cuid())

  name  String?
  email String? @unique

  // Optional for email/password authentication.
  // Google-only accounts keep this null.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One profile per user
  profile TravelerProfile?

  // User food preferences
  foodPreferences UserFoodPreference[]

  // Places
  savedPlaces   SavedPlace[]
  visitedPlaces VisitedPlace[]

  // History
  searchHistory SearchHistory[]
  foodScans     FoodScan[]

  // Trips
  trips Trip[]

  // Traveler memory
  travelSources     TravelSource[]
  travelPlaces      TravelPlace[]
  travelRoutes      TravelRoute[]
  travelExpenses    TravelExpense[]
  travelExperiences TravelExperience[]
}

// ============================================================
// TRAVELER PROFILE
// ============================================================

model TravelerProfile {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  travelerType TravelerType @default(TOURIST)

  // User's display currency
  currency CurrencyCode @default(INR)

  // Dietary preferences
  vegetarian Boolean @default(false)
  vegan      Boolean @default(false)

  // Food preferences
  preferredSpice   SpiceLevel?
  preferredCuisine String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// USER FOOD PREFERENCE
// ============================================================
//
// Examples:
// Pani Puri
// Vada Pav
// Biryani
//
// A separate relation makes preferences easy to
// extend later without stuffing many fields into User.
//

model UserFoodPreference {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodId String

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  // How strongly the user likes it
  preferenceScore Int @default(1)

  createdAt DateTime @default(now())

  @@unique([userId, foodId])
  @@index([userId])
  @@index([foodId])
}

// ============================================================
// FOOD
// ============================================================

model Food {
  id String @id @default(cuid())

  name String

  description String?

  cuisine String[]

  diet FoodDiet?

  spiceLevel SpiceLevel?

  mealTypes String[]

  imageUrl String?

  ingredients String[]
  tags        String[]

  // General/reference price in INR
  priceInr Int?

  priceRange PriceRange?

  priceEstimated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prices      FoodPrice[]
  scans       FoodScan[]
  preferences UserFoodPreference[]

  @@index([name])
}

// ============================================================
// PLACE
// ============================================================
//
// A general geographic place.
// It can represent:
// - restaurant
// - cafe
// - market
// - attraction
// - park
// - museum
// - landmark
//
// This prevents FairTrip from treating every Geoapify result
// as a restaurant.
//

model Place {
  id String @id @default(cuid())

  // Geoapify / other external provider ID
  externalId String? @unique

  name String

  type PlaceType

  address String?

  city    String?
  state   String?
  country String?

  latitude  Float
  longitude Float

  phone   String?
  website String?

  openingHours Json?

  imageUrl String?

  source String @default("Geoapify")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restaurant data, if this place is a food business
  restaurant Restaurant?

  // User interaction
  savedBy   SavedPlace[]
  visitedBy VisitedPlace[]

  @@index([latitude, longitude])
  @@index([type])
  @@index([city])
}

// ============================================================
// RESTAURANT
// ============================================================
//
// Restaurant is a food-specific representation of a Place.
// A place may or may not be a restaurant.
//

model Restaurant {
  id String @id @default(cuid())

  placeId String @unique

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // Food sold at this restaurant
  foodPrices FoodPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// FOOD PRICE
// ============================================================
//
// This is the important model for your real food search.
//
// Example:
//
// Pani Puri
//   Restaurant A -> ₹40
//   Restaurant B -> ₹50
//
// Do not assume that every restaurant has the same price.
//

model FoodPrice {
  id String @id @default(cuid())

  foodId String

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  priceInr Int

  currency CurrencyCode @default(INR)

  estimated Boolean @default(false)

  source PriceSource

  sourceUrl String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, restaurantId])
  @@index([foodId])
  @@index([restaurantId])
  @@index([priceInr])
}

// ============================================================
// FOOD SCAN HISTORY
// ============================================================
//
// Keep the useful history only:
// what the user scanned, confidence, when it happened.
//
// Don't store huge image blobs in PostgreSQL.
//

model FoodScan {
  id String @id @default(cuid())

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  foodId String?

  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  recognizedName String

  confidence Float?

  imageUrl String?

  mode FoodRecognitionMode

  source String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([foodId])
  @@index([createdAt])
}

// ============================================================
// SAVED PLACE
// ============================================================

model SavedPlace {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
}

// ============================================================
// VISITED PLACE
// ============================================================
//
// This is the useful part of "travel history".
// We don't need to record every GPS coordinate.
//

model VisitedPlace {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  visitedAt DateTime @default(now())

  // Optional short user note
  note String?

  @@index([userId])
  @@index([placeId])
  @@index([visitedAt])
}

// ============================================================
// SEARCH HISTORY
// ============================================================
//
// Only useful search information:
// query + location context + traveler type.
//
// No need to store every API response.
//

model SearchHistory {
  id String @id @default(cuid())

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  query String

  locationQuery String?

  latitude  Float?
  longitude Float?

  travelerType TravelerType?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// TRIP
// ============================================================
//
// Stores only normal trip information.
//

model Trip {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  sourceName      String?
  sourceLatitude  Float?
  sourceLongitude Float?

  destinationName      String?
  destinationLatitude  Float?
  destinationLongitude Float?

  budgetInr Int?

  travelerType TravelerType @default(TOURIST)

  startDate DateTime?
  endDate   DateTime?

  // Traveler-memory lifecycle
  status TripStatus @default(ACTIVE)

  // Cached journey statistics
  totalKnownSpendInr     Int @default(0)
  totalTransportSpendInr Int @default(0)
  totalOtherSpendInr     Int @default(0)

  knownDistanceMeters  Int?
  knownDurationMinutes Int?

  sourceCount  Int @default(0)
  placeCount   Int @default(0)
  routeCount   Int @default(0)
  expenseCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Traveler memory
  sources     TravelSource[]
  places      TravelPlace[]
  routes      TravelRoute[]
  expenses    TravelExpense[]
  experiences TravelExperience[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model TravelSource {
  id String @id @default(cuid())

  userId String
  tripId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  platform   TravelSourcePlatform
  sourceUrl  String
  sourceId   String?
  sourceType TravelSourceType

  title        String?
  channelName  String?
  publishedAt  DateTime?
  thumbnailUrl String?
  contentId    String?

  transcriptProvided Boolean                @default(false)
  processingStatus   TravelProcessingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences TravelExperience[]

  @@unique([tripId, sourceUrl])
  @@index([userId])
  @@index([tripId])
  @@index([contentId])
}

model TravelPlace {
  id String @id @default(cuid())

  userId String
  tripId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name    String
  address String?
  city    String?
  state   String?
  country String?

  latitude  Float?
  longitude Float?

  sequence   Int
  confidence Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tripId])
  @@index([tripId, sequence])
}

model TravelRoute {
  id String @id @default(cuid())

  userId String
  tripId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  sequence Int

  fromName String
  toName   String
  fromCity String?
  toCity   String?

  transportMode TravelTransportMode

  distanceMeters  Int?
  durationMinutes Int?
  amountPaidInr   Int?

  fareSource FareSource @default(UNKNOWN)

  experience String?
  evidence   String?
  confidence Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tripId])
  @@index([tripId, sequence])
}

model TravelExpense {
  id String @id @default(cuid())

  userId String
  tripId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  sequence    Int?
  category    TravelExpenseCategory
  description String
  amountInr   Int
  placeName   String?
  evidence    String?
  confidence  Float

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tripId])
  @@index([tripId, sequence])
}

model TravelExperience {
  id String @id @default(cuid())

  userId   String
  tripId   String
  sourceId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  source TravelSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  sequence Int?

  title   String
  summary String

  experienceType TravelExperienceType
  category       TravelExpenseCategory
  subcategory    String?

  placeName String?
  city      String?

  reportedAmountInr Int?
  expectedAmountInr Int?
  transportMode     TravelTransportMode?

  problem String?

  advice      String[]
  sourceQuote String?

  confidence Float

  // A model-generated report can never become a public verdict automatically.
  visibility TravelVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tripId])
  @@index([sourceId])
}

enum TripStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TravelSourcePlatform {
  YOUTUBE
  INSTAGRAM
}

enum TravelSourceType {
  CHANNEL
  PROFILE
  VIDEO
  POST
}

enum TravelProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TravelTransportMode {
  WALK
  BUS
  TRAIN
  METRO
  SHARED_AUTO
  METER_AUTO
  TAXI
  APP_TAXI
  FERRY
  FLIGHT
  OTHER
  UNKNOWN
}

enum FareSource {
  EXPLICIT
  CALCULATED
  UNKNOWN
}

enum TravelExpenseCategory {
  TRANSPORT
  FOOD
  SHOPPING
  HOTEL
  ATTRACTION
  SERVICE
  OTHER
}

enum TravelExperienceType {
  POSITIVE
  NEGATIVE
  NEUTRAL
  WARNING
  POSSIBLE_OVERCHARGE
  REPORTED_SCAM
}

enum TravelVisibility {
  PRIVATE
  FAIRTRIP_CANDIDATE
  FAIRTRIP_PUBLIC
}

// ============================================================

enum CurrencyCode {
  INR
  USD
  EUR
  GBP
  JPY
  AUD
  CAD
  SGD
  AED
}

enum TravelerType {
  TOURIST
  CITIZEN
}

enum FoodDiet {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGG
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  VERY_HOT
}

enum PriceRange {
  INR_1
  INR_2
  INR_3
}

enum PriceSource {
  SCANNED_MENU
  RESTAURANT_MENU
  VERIFIED_SOURCE
  USER_SUBMITTED
  ESTIMATED
}

enum FoodRecognitionMode {
  FOOD
  MENU
}

enum PlaceType {
  RESTAURANT
  CAFE
  FOOD_STALL
  MARKET
  ATTRACTION
  PARK
  MUSEUM
  RELIGIOUS
  HOTEL
  LANDMARK
  OTHER
}